# Copy to backend/.env (this file is for documentation; never commit real keys)
# The app runs fully on free/local sources: Sourcify, public RPCs, GoPlus, DexScreener,
# RDAP, OpenPhish, Binance, CoinGecko (keyless), Frankfurter, and a local Ollama model.
# Everything below with an empty value is OPTIONAL enrichment only.

# "demo" = simulated sample data only (no keys needed). "live" = real API calls.
# The user can also switch mode in the UI.
APP_MODE=demo

# --- Optional: LLM claim extraction + plain-language explanation (live mode only) ---
# auto       = try Groq (if key) -> OpenRouter (if key) -> Gemini (if key) -> local Ollama -> deterministic
# groq       = Groq cloud primary (free tier: 14,400 req/day; get key at https://console.groq.com/keys)
# openrouter = OpenRouter cloud (free models; get key at https://openrouter.ai/keys)
# gemini     = Google Gemini (free tier; get key at https://aistudio.google.com/app/apikey)
# ollama     = local only - 100% offline via local Ollama daemon
# none       = heuristic extractor + template summary only.
LLM_PROVIDER=auto

# Primary Cloud AI: Groq (Llama 3.3 70B Versatile - fast, accurate, free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary Cloud AI: OpenRouter (optional free tier models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Tertiary Cloud AI: Google Gemini (optional free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Standby AI: Ollama (runs locally, zero-cost, no key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=20.0
LLM_TIMEOUT_SECONDS=15.0

# Optional legacy Anthropic fallback:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Data sources ---
# CoinGecko works keyless (rate-limited). A free "Demo" key raises limits.
COINGECKO_API_KEY=
# Optional extra contract-verification layer. Without it Sourcify + public RPCs still verify.
ETHERSCAN_API_KEY=
# Optional website-safety layer. Without it the OpenPhish phishing feed is used instead.
GOOGLE_SAFE_BROWSING_API_KEY=
# GoPlus, DexScreener, Sourcify, RDAP, OpenPhish, Binance and Frankfurter need no key.

# --- Limits / tuning ---
HTTP_TIMEOUT_SECONDS=8
CACHE_TTL_SECONDS=600
MAX_INPUT_CHARS=6000
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_PER_10MIN=30
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
